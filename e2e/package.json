{
  "name": "e2e",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prepare:prisma": "prisma generate --config ../api/prisma.config.ts",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:wait": "bash docker/wait-for-http.sh http://localhost:3030/health 180",
    "docker:down": "docker compose -f docker/docker-compose.yml down -v --remove-orphans",
    "test:docker": "bash docker/run-e2e.sh run",
    "test:docker:interactive": "bash docker/run-e2e.sh interactive",
    "test:docker:watch": "bash docker/run-e2e.sh watch",
    "down:docker": "bash docker/run-e2e.sh down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@prisma/client": "7.0.0",
    "cypress": "^15.10.0",
    "nodemon": "^3.1.7",
    "prisma": "7.0.0"
  },
  "dependencies": {
    "cypress-yaml-plugin": "^0.1.14",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0"
  }
}
